{
 "name": "Hall Pass",
 "tagline": "gymnasium-sized wash, taped straight off the vhs",
 "enclosure": {
  "width": 2.4,
  "depth": 2.9,
  "height": 0.6,
  "color": "#1F8A8F"
 },
 "artwork": {
  "style": "waves",
  "palette": [
   "#14B8A6",
   "#7C3AED",
   "#EC4899"
  ],
  "textColor": "#FDF4FF"
 },
 "chain": [
  {
   "id": "ch",
   "type": "chorus",
   "params": {
    "rate": 3.0,
    "depth": 3.5,
    "mix": 2.5
   }
  },
  {
   "id": "fl",
   "type": "filter",
   "params": {
    "cutoff": 6.0,
    "resonance": 1.5
   }
  },
  {
   "id": "rv",
   "type": "reverb",
   "params": {
    "size": 7.5,
    "mix": 6.5
   }
  },
  {
   "id": "lv",
   "type": "level",
   "params": {
    "gain": 5.5
   }
  }
 ],
 "controls": [
  {
   "id": "k1",
   "label": "SIZE",
   "target": "rv.size"
  },
  {
   "id": "k2",
   "label": "MIX",
   "target": "rv.mix"
  },
  {
   "id": "k3",
   "label": "SHEEN",
   "target": "ch.mix"
  },
  {
   "id": "k4",
   "label": "LEVEL",
   "target": "lv.gain"
  }
 ],
 "switches": [
  {
   "id": "s1",
   "label": "BRIGHT",
   "target": "fl.cutoff",
   "off": 6.0,
   "on": 8.0
  }
 ],
 "bakedFrom": "reverb 90s"
}