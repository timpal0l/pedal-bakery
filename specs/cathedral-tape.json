{
  "name": "Cathedral Tape",
  "tagline": "long echoes under stone",
  "enclosure": { "width": 2.6, "depth": 2.3, "height": 0.5, "color": "#2b3a55" },
  "artwork": { "style": "gradient", "palette": ["#31406b", "#141b2e", "#8fa7d9"], "textColor": "#dfe8ff" },
  "chain": [
    { "id": "echo", "type": "delay", "params": { "time": 6, "feedback": 5, "mix": 5 } },
    { "id": "verb", "type": "reverb", "params": { "size": 7, "mix": 4 } }
  ],
  "controls": [
    { "id": "time",  "label": "TIME",  "target": "echo.time" },
    { "id": "regen", "label": "REGEN", "target": "echo.feedback" },
    { "id": "blend", "label": "BLEND", "target": "echo.mix" },
    { "id": "size",  "label": "SIZE",  "target": "verb.size" },
    { "id": "wash",  "label": "WASH",  "target": "verb.mix" }
  ],
  "switches": []
}
