{
  "name": "Neon Mirage",
  "tagline": "chrome sunsets and cassette dreams",
  "enclosure": {
    "width": 3.6,
    "depth": 3.0,
    "height": 0.75,
    "color": "#241a4f"
  },
  "artwork": {
    "style": "waves",
    "palette": [
      "#ff2fb3",
      "#00e5ff",
      "#7b2fff"
    ],
    "textColor": "#f7ecff"
  },
  "chain": [
    {
      "id": "ph",
      "type": "phaser",
      "params": {
        "rate": 3.0,
        "depth": 6.5,
        "feedback": 5.0
      }
    },
    {
      "id": "ch",
      "type": "chorus",
      "params": {
        "rate": 4.0,
        "depth": 7.0,
        "mix": 6.0
      }
    },
    {
      "id": "dl",
      "type": "delay",
      "params": {
        "time": 4.0,
        "feedback": 5.5,
        "mix": 4.5
      }
    },
    {
      "id": "rv",
      "type": "reverb",
      "params": {
        "size": 6.0,
        "mix": 4.0
      }
    }
  ],
  "controls": [
    {
      "id": "k1",
      "label": "SWIRL",
      "target": "ph.rate"
    },
    {
      "id": "k2",
      "label": "PHASE",
      "target": "ph.depth"
    },
    {
      "id": "k3",
      "label": "SHIMMER",
      "target": "ch.depth"
    },
    {
      "id": "k4",
      "label": "TIME",
      "target": "dl.time"
    },
    {
      "id": "k5",
      "label": "REPEATS",
      "target": "dl.feedback"
    },
    {
      "id": "k6",
      "label": "ECHO",
      "target": "dl.mix"
    },
    {
      "id": "k7",
      "label": "WASH",
      "target": "rv.mix"
    }
  ],
  "switches": [
    {
      "id": "s1",
      "label": "VIBE",
      "target": "ch.mix",
      "off": 6.0,
      "on": 10
    },
    {
      "id": "s2",
      "label": "VOID",
      "target": "rv.size",
      "off": 6.0,
      "on": 9.5
    }
  ],
  "bakedFrom": "trippy 80s"
}