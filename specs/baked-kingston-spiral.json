  },
  {
   "id": "k2",
   "label": "REGEN",
   "target": "dly.feedback"
  },
  {
   "id": "k3",
   "label": "MIX",
   "target": "dly.mix"
  },
  {
   "id": "k4",
   "label": "CUTOFF",
