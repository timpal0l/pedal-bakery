  {
   "id": "k6",
   "label": "SPACE",
   "target": "rvb.size"
  }
 ],
 "switches": [
  {
   "id": "s1",
   "label": "DIRT",
   "target": "drv.amount",
   "off": 2.5,
   "on": 7.0
  },
  {
   "id": "s2",
   "label": "WASH",
   "target": "rvb.mix",
   "off": 3.5,
   "on": 8.0
