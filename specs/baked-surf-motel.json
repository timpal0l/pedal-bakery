    {
      "id": "k2",
      "label": "TANK",
      "target": "tank.size"
    },
    {
      "id": "k3",
      "label": "TONE",
      "target": "tone.treble"
    }
  ],
  "switches": [
    {
      "id": "s1",
      "label": "DRIP",
      "target": "tone.bass",
      "off": 3.5,
      "on": 1.5
