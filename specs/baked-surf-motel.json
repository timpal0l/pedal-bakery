{
  "kind": "pedal",
  "shape": "box",
  "name": "Surf Motel",
  "tagline": "tank clang and wet tile",
  "enclosure": {
    "width": 2.4,
    "depth": 2.6,
    "height": 0.62,
    "color": "#1f6f8b"
  },
  "artwork": {
    "style": "waves",
    "palette": [
      "#1f6f8b",
      "#f0e6d2",
      "#d9a441"
    ],
